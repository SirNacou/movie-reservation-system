{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "bun --cwd ../../packages/contract build",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:pending": "mikro-orm migration:pending",
    "migration:fresh": "mikro-orm migration:fresh",
    "start": "nest start",
    "prestart:dev": "bun --cwd ../../packages/contract build",
    "start:dev": "nest start --watch --no-shell",
    "predev": "bun --cwd ../../packages/contract build",
    "dev": "nest start --debug --watch",
    "start:debug": "nest start --debug --watch --no-shell",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/decorators": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.1",
    "@mikro-orm/reflection": "^7.2.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@nestjs/schedule": "^12.0.2",
    "@orpc/contract": "2.0.0-beta.37",
    "@orpc/nest": "2.0.0-beta.37",
    "@orpc/server": "2.0.0-beta.37",
    "@praha/byethrow": "^0.12.0",
    "@praha/error-factory": "^1.4.1",
    "@repo/contract": "workspace:*",
    "bullmq": "^6.3.8",
    "envin": "^1.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}